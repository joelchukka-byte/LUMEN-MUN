{
  "name": "lumen-mun",
  "version": "1.0.0",
  "private": true,
  "description": "Lumen MUN Edition I — conference site, delegate lifecycle and operations console.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.pglite',{recursive:true,force:true})\" && npm run db:push -- --force && npm run db:seed",
    "crest": "node scripts/crest-hires.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.38.4",
    "jsqr": "^1.4.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "nodemailer": "^6.9.16",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
